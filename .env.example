# Copie este arquivo para .env quando rodar na sua maquina.
# No Railway voce NAO cria .env: as variaveis vao no painel do servico.

# --- Banco -------------------------------------------------
# No Railway, ligando o MySQL ao servico, ele injeta MYSQL_URL sozinho.
# Localmente, use as variaveis separadas abaixo.
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=lumina

# --- Seguranca ---------------------------------------------
# Frase longa e aleatoria. Se mudar, todo mundo e deslogado.
JWT_SEGREDO=troque-isto-por-uma-frase-longa-e-aleatoria

# --- Recuperacao de senha ----------------------------------
# true  = o codigo de 6 digitos aparece na tela (so para testar)
# false = o codigo so aparece nos logs do servidor (use em producao)
MODO_DEMO=false

# --- Servidor ----------------------------------------------
# O Railway define a PORT sozinho. Localmente, 3000 serve.
PORT=3000
